{
  "manifest_version": 3,
  "name": "FocusSafe AI Page Assistant",
  "description": "Reads visible page content and provides AI assistance in a side panel without stealing page focus.",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FocusSafe AI"
  },
  "commands": {
    "toggle_assistant": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Open AI side panel"
    },
    "analyze_selection": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Analyze selected text"
    },
    "capture_and_analyze": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Capture visible tab and analyze"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
